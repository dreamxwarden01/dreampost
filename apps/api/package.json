{
  "name": "@dreampost/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "migrate": "tsx src/commands/migrate.ts",
    "seed": "tsx src/commands/seed.ts",
    "jobs": "tsx src/commands/jobs.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@dreampost/protocol": "workspace:*",
    "css-tree": "3.2.1",
    "fastify": "5.12.5",
    "htmlparser2": "12.0.0",
    "jose": "^6.1.0",
    "pg": "8.23.0",
    "postal-mime": "3.0.1",
    "sanitize-html": "2.17.7",
    "tldts": "7.4.15"
  },
  "devDependencies": {
    "@types/css-tree": "3.2.0",
    "@types/pg": "^8.15.6",
    "@types/sanitize-html": "2.16.1"
  }
}
