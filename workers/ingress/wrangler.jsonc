{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dreampost-ingress",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  "workers_dev": false,
  "preview_urls": false,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "vars": {
    "ROUTING_MODE": "static",
    "POLICY_ALLOWED_DOMAINS_JSON": "[\"example.test\"]",
    "RECIPIENT_ROUTES_JSON": "{\"inbox@example.test\":\"11111111-1111-4111-8111-111111111111\"}",
    "BACKEND_INGEST_URL": "https://api.example.test/internal/v1/deliveries",
    "INGEST_KEY_ID": "development",
    "ALLOW_INSECURE_LOCAL_BACKEND": "false",
    "DONE_RETENTION_DAYS": "7"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dreampost-ingress",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "RAW_MAIL", "bucket_name": "dreampost-ingress-raw" }
  ],
  "queues": {
    "producers": [
      { "binding": "DELIVERY_QUEUE", "queue": "dreampost-ingress" }
    ],
    "consumers": [
      {
        "queue": "dreampost-ingress",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_concurrency": 4,
        "max_retries": 10,
        "retry_delay": 30,
        "dead_letter_queue": "dreampost-ingress-dlq"
      }
    ]
  },
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
}
