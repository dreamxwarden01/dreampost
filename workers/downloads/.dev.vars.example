# ALLOW_INSECURE_LOCAL="true"
# APP_ORIGIN="http://127.0.0.1:5173"
# DOWNLOAD_ORIGIN="http://127.0.0.1:8788"
# BACKEND_CONTROL_URL="http://127.0.0.1:3001/internal/v1/attachments/control"

