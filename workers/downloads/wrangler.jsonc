{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dreampost-downloads-example",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-27",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_ORIGIN": "https://mail.example.test",
    "DOWNLOAD_ORIGIN": "https://downloads.example.test",
    "BACKEND_CONTROL_URL": "https://api.example.test/internal/v1/attachments/control",
    "CONTROL_KEY_ID": "downloads-1",
    "MAX_DOWNLOAD_SESSIONS": "16",
    "MAX_BOOTSTRAP_CHALLENGES": "4"
  },
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "dreampost-attachments-example"
    }
  ],
  "ratelimits": [
    {
      "name": "REQUEST_START_LIMITER",
      "namespace_id": "10001",
      "simple": {
        "limit": 600,
        "period": 60
      }
    }
  ]
}
